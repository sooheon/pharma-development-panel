{
  "permissions": {
    "file_operations": {
      "read": true,
      "write": true,
      "create": true,
      "modify": true
    },
    "allowed_tools": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "TodoWrite",
      "Bash",
      "Task"
    ]
  },
  "hooks": {
    "pre-session": ".claude/hooks/pre-session.sh",
    "post-task": ".claude/hooks/post-task.sh",
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-specialist.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-specialist.sh"
          }
        ]
      }
    ]
  },
  "environment": {
    "SCENARIO_PANEL_ROOT": ".",
    "SCENARIO_TEMPLATES_DIR": "./templates",
    "SCENARIOS_DIR": "./scenarios/active"
  },
  "validation": {
    "require_scenario_id": true,
    "enforce_transcript_creation": true,
    "require_user_validation": true,
    "minimum_transcript_words": 100
  },
  "project_type": "ai_drug_discovery",
  "workflow_enforcement": "pipeline_based",
  "pipeline_stages": {
    "target_discovery": {
      "description": "Target identification and validation",
      "required_documents": [
        "target_assessment.md"
      ],
      "suggested_specialists": [
        "systems_biologist",
        "structural_biologist",
        "functional_genomics_specialist"
      ],
      "completion_trigger": "target_validated"
    },
    "hit_generation": {
      "description": "Hit finding and virtual screening",
      "required_documents": [
        "hit_list.md"
      ],
      "suggested_specialists": [
        "computational_chemist",
        "structural_biologist",
        "medicinal_chemist"
      ],
      "completion_trigger": "hits_prioritized"
    },
    "lead_optimization": {
      "description": "Hit-to-lead and lead optimization",
      "required_documents": [
        "lead_assessment.md"
      ],
      "suggested_specialists": [
        "medicinal_chemist",
        "computational_chemist",
        "pharmacologist"
      ],
      "completion_trigger": "candidate_selected"
    },
    "preclinical": {
      "description": "IND-enabling studies",
      "required_documents": [
        "ind_readiness.md"
      ],
      "suggested_specialists": [
        "toxicologist",
        "pharmacologist",
        "translational_scientist",
        "cmc_specialist"
      ],
      "completion_trigger": "ind_ready"
    },
    "clinical": {
      "description": "Clinical development planning",
      "required_documents": [
        "clinical_plan.md"
      ],
      "suggested_specialists": [
        "clinical_pharmacologist",
        "oncologist",
        "regulatory_specialist",
        "biomarker_specialist"
      ],
      "completion_trigger": "clinical_strategy_approved"
    }
  },
  "specialists": {
    "systems_biologist": {
      "name": "Dr. Jin-Woo Park",
      "focus": "Target ID, pathways, multi-omics integration",
      "prompt_file": "prompts/specialists/systems_biologist.md"
    },
    "structural_biologist": {
      "name": "Dr. Sarah Chen",
      "focus": "Protein structure, binding sites, AlphaFold",
      "prompt_file": "prompts/specialists/structural_biologist.md"
    },
    "computational_chemist": {
      "name": "Dr. Marcus Weber",
      "focus": "Virtual screening, ADMET, molecular simulation",
      "prompt_file": "prompts/specialists/computational_chemist.md"
    },
    "medicinal_chemist": {
      "name": "Dr. Elena Rodriguez",
      "focus": "SAR, lead optimization, drug-likeness",
      "prompt_file": "prompts/specialists/medicinal_chemist.md"
    },
    "pharmacologist": {
      "name": "Dr. David Kim",
      "focus": "PK/PD, efficacy models, dose prediction",
      "prompt_file": "prompts/specialists/pharmacologist.md"
    },
    "toxicologist": {
      "name": "Dr. Lisa Thompson",
      "focus": "Safety assessment, IND-enabling, risk mitigation",
      "prompt_file": "prompts/specialists/toxicologist.md"
    },
    "translational_scientist": {
      "name": "Dr. Min-Ji Kang",
      "focus": "Organoids, PDX, preclinical validation",
      "prompt_file": "prompts/specialists/translational_scientist.md"
    },
    "bioinformatician": {
      "name": "Dr. Alex Nakamura",
      "focus": "AI/ML architecture, multi-omics pipelines",
      "prompt_file": "prompts/specialists/bioinformatician.md"
    },
    "ai_scientist": {
      "name": "Dr. Yuna Kim",
      "focus": "Model training, evaluation, closed-loop learning",
      "prompt_file": "prompts/specialists/ai_scientist.md"
    },
    "functional_genomics_specialist": {
      "name": "Dr. Kevin Park",
      "focus": "CRISPR screens, perturbation biology",
      "prompt_file": "prompts/specialists/functional_genomics_specialist.md"
    },
    "clinical_data_scientist": {
      "name": "Dr. Sung-Hee Cho",
      "focus": "EMR analysis, real-world evidence",
      "prompt_file": "prompts/specialists/clinical_data_scientist.md"
    },
    "biomarker_specialist": {
      "name": "Dr. Rachel Green",
      "focus": "Companion diagnostics, patient selection",
      "prompt_file": "prompts/specialists/biomarker_specialist.md"
    },
    "cmc_specialist": {
      "name": "Dr. Robert Zhang",
      "focus": "Formulation, manufacturing, scale-up",
      "prompt_file": "prompts/specialists/cmc_specialist.md"
    },
    "regulatory_specialist": {
      "name": "Dr. Jennifer Park",
      "focus": "IND/NDA strategy, FDA/MFDS/EMA",
      "prompt_file": "prompts/specialists/regulatory_specialist.md"
    },
    "clinical_pharmacologist": {
      "name": "Dr. Michael Santos",
      "focus": "FIH design, dose selection, human PK/PD",
      "prompt_file": "prompts/specialists/clinical_pharmacologist.md"
    },
    "oncologist": {
      "name": "Dr. Hannah Lee",
      "focus": "Disease expertise, clinical trials, patient selection",
      "prompt_file": "prompts/specialists/oncologist.md"
    },
    "sarcoma_specialist": {
      "name": "Dr. James Morrison",
      "focus": "Rare tumors, sarcoma subtypes, orphan pathways",
      "prompt_file": "prompts/specialists/sarcoma_specialist.md"
    },
    "virologist": {
      "name": "Dr. Catherine Wu",
      "focus": "BK virus, polyomaviruses, antivirals",
      "prompt_file": "prompts/specialists/virologist.md"
    }
  }
}
